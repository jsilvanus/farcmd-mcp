{
  "name": "@jsilvanus/farcmd-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OAuth-protected MCP server for predefined SSH command capabilities.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "concurrently -k \"tsx watch src/server.ts\" \"vite --host 0.0.0.0\"",
    "start": "node dist/server.js",
    "build:web": "vite build",
    "test": "node --import tsx --test test/security.test.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.2.1",
    "jose": "^6.2.12",
    "zod": "^4.6.5",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^7.1.5",
    "concurrently": "^9.1.2",
    "@types/ssh2": "^1.15.6"
  }
}

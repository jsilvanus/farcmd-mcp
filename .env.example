PORT=5999
# Host port docker-compose.yml publishes on 127.0.0.1 for the reverse proxy (default 5999)
# FARCMD_HOST_PORT=5999
# Image tag the compose files pull from ghcr.io/jsilvanus/farcmd-mcp (default 1 = latest 1.x)
# FARCMD_VERSION=1.0.0
# Public https:// origin clients use (required in production; TLS terminates at the reverse proxy)
MCP_PUBLIC_URL=https://farcmd.example.com
JWT_SECRET=<base64-encoded-random-secret-at-least-32-bytes>
FARCMD_ENCRYPTION_KEY=<base64-encoded-random-32-byte-key>
STORAGE_PATH=./data/app.sqlite
# NODE_ENV=production
# MCP_DEFAULT_USER_EMAIL=
# MCP_DEFAULT_USER_PASSWORD=
# Audit log retention in days (0 = keep forever)
# FARCMD_AUDIT_RETENTION_DAYS=365
# Execution history retention in days: runs and their stdout/stderr (0 = keep forever)
# FARCMD_EXECUTION_RETENTION_DAYS=365
# Reverse proxy addresses allowed to set X-Forwarded-For/-Proto: unset/false, true, a hop count,
# or comma-separated IPs/CIDRs (e.g. 127.0.0.1 for nginx on the host, the proxy network subnet for Traefik)
# FARCMD_TRUST_PROXY=127.0.0.1
# Maximum MCP output captured per execution (bytes)
# FARCMD_MAX_OUTPUT_BYTES=262144
# Concurrent SSH executions in total and per SSH target (over the limit: refused, not queued)
# FARCMD_SSH_MAX_CONCURRENT=8
# FARCMD_SSH_MAX_PER_TARGET=2
# New MCP executions per user and OAuth client per minute (0 = no limit)
# FARCMD_MCP_EXECUTIONS_PER_MINUTE=30
